<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- ! Makes the test executable accept the same MTP switches as dotnet test -->
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.MTP" />
		<PackageReference Include="JsonSchema.Net" />
		<PackageReference Include="Microsoft.Testing.Extensions.GitHubActionsReport" />
		<PackageReference Include="xunit.v3.mtp-v2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\JXSchemaGenerator.Core\JXSchemaGenerator.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
