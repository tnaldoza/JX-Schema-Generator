# * Line endings
# ! LF everywhere so Windows checkouts and Linux CI produce byte-identical generated output
* text=auto eol=lf

# * Windows-native scripts keep CRLF
*.ps1        text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf

# * Explicit text types
*.cs         text eol=lf diff=csharp
*.csproj     text eol=lf
*.props      text eol=lf
*.targets    text eol=lf
*.slnx       text eol=lf
*.xsd        text eol=lf
*.xml        text eol=lf
*.js         text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf
*.ts         text eol=lf
*.json       text eol=lf
*.jsonc      text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.sh         text eol=lf

# * Generated
pnpm-lock.yaml  text eol=lf linguist-generated

# * Binaries
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.zip        binary
*.gz         binary
*.dll        binary
*.exe        binary
