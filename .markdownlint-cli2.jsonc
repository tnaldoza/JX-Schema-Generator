{
	"$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.24.0/schema/markdownlint-cli2-config-schema.json",
	"config": {
		"default": true,
		"MD010": false,
		"MD013": false,
		"MD033": false,
		"MD060": false,
	},
	"globs": ["**/*.md"],
	"gitignore": true,
	"ignores": ["node_modules/**", "**/bin/**", "**/obj/**", "dist/**", "schemas/**", "docs/superpowers/**"],
}
